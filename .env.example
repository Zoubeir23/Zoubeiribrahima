# Noms des variables seulement. Les valeurs vont dans .env.local (ignoré par git) et dans les réglages du projet Vercel.

# Clé d'API Resend : enregistre les personnes qui débloquent les ressources (api/resources/subscribe.ts).
RESEND_API_KEY=

# Base Neon (intégration Vercel) : retient une empreinte des e-mails déjà envoyés à Resend, pour ne pas les renvoyer.
# Facultative : sans elle, ou si la base ne répond pas, Resend décide seul (api/resources/subscribe.ts).
DATABASE_URL=
